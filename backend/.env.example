# ============================================================
# Environment Variables Template — DO NOT commit real values
# Copy this file to .env and fill in your actual credentials
# On Hugging Face Spaces, set these as Repository Secrets
# ============================================================

FLASK_APP=app.py
FLASK_ENV=production
PORT=7860

# MongoDB — Use MongoDB Atlas (free tier) for production
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/leukemia_db
MONGO_DB_NAME=leukemia_db
